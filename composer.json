{
    "name": "ubermuda/health-check-bundle",
    "description": "Infrastructure diagnostics and a liveness endpoint for Symfony: honest four-state checks an operator can act on, and a /healthz a load balancer can poll.",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.2",
        "psr/log": "^3.0",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/translation": "^8.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "symfony/phpunit-bridge": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Ubermuda\\HealthCheckBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ubermuda\\HealthCheckBundle\\Test\\": "test/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": false
        }
    }
}
